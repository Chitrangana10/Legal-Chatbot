APP_NAME="Intelligent Legal RAG System"
ENVIRONMENT=development
LOG_LEVEL=INFO

# Direct Python connects to the same local Docker PostgreSQL database on port 5433.
# If POSTGRES_PASSWORD is customized, update the password in this URL too.
# Compose overrides the host/port to postgres:5432 inside its network.
DATABASE_URL=postgresql+psycopg://legal:local-development-only@127.0.0.1:5433/legal_chatbot
SESSION_HOURS=24
REDIS_URL=redis://127.0.0.1:6379/0
ENABLE_ANSWER_CACHE=true
ANSWER_CACHE_TTL_SECONDS=86400
ANSWER_CACHE_VERSION=v1
# Required on EC2; use a random hexadecimal password (no URL special characters).
# Set it before the first deployment and retain it for the existing DB volume.
POSTGRES_PASSWORD=

TOGETHER_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=

EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_LLM_MODEL=gemini-3.5-flash

PROJECT_ROOT=.
RAW_DATA_DIR=backend/data/raw
PROCESSED_DATA_DIR=backend/data/processed
FAISS_INDEX_DIR=backend/data/faiss_index
